# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Intelligent Farming Foundation
#
# Copy to .env and adjust. .env is git-ignored — never commit real secrets.
# Defaults boot a working localhost bench with no edits.

# ── ChirpStack ───────────────────────────────────────────────────────────────
# Active region / sub-band. This single flag drives ChirpStack's enabled_regions,
# both gateway bridges' MQTT topic prefix, and the BasicStation channel-plan file.
# Default us915_0 (channels 0-7). Set us915_1 for channels 8-15. For any other band,
# add chirpstack/region_<id>.toml and (if using BasicStation)
# gateway-bridge/chirpstack-gateway-bridge-basicstation-<id>.toml, then set REGION=<id>.
REGION=us915_0

# Signs ChirpStack login + API tokens. CHANGE THIS for anything beyond a private
# bench. Generate one with: openssl rand -base64 32
CHIRPSTACK_API_SECRET=change-me-please

# Bootstrap admin login the provisioner uses (ChirpStack v4 default is admin/admin).
CHIRPSTACK_ADMIN_EMAIL=admin
CHIRPSTACK_ADMIN_PASSWORD=admin

# Host ports. Change these to run alongside an existing ChirpStack/Mosquitto on
# the same host (e.g. a separate chirpstack-docker stack). Internal service-to-
# service traffic uses the compose network and is unaffected — but if you remap
# the MQTT/REST host ports, also update LEFTENANT_CHIRPSTACK_URL / LEFTENANT_MQTT_URL
# below to match (the browser uses those).
CHIRPSTACK_HOST_PORT=8080          # admin UI + gRPC
CHIRPSTACK_REST_HOST_PORT=8090     # REST API (Leftenant calls this)
# GATEWAY_BRIDGE_UDP_PORT is the HOST side of the 1700/udp mapping. The mock
# harness's send *target* is MOCK_UDP_PORT (see the mock-sensors block below).
GATEWAY_BRIDGE_UDP_PORT=1700       # Semtech UDP packet forwarder gateways (UDP)
GATEWAY_BRIDGE_BASICSTATION_PORT=3001  # BasicStation gateways (LNS WebSocket, TCP)
MOSQUITTO_MQTT_PORT=1883           # native MQTT
MOSQUITTO_WS_PORT=9001             # MQTT over websockets (browser join monitor)

# ── Tenant / API key created by the provisioner ──────────────────────────────
TENANT_NAME=Intelligent Farming
API_KEY_NAME=intelligent-farming-stack

# Optional ChirpStack JS payload codecs the provisioner best-effort attaches to
# device profiles. Defaults to this repo's ./codecs (drop *.js there). Point it at
# another folder — e.g. ../intelligent-farming-hub/codecs — to reuse a codec set
# from elsewhere. Empty/missing dir = no-op.
CODECS_DIR=./codecs

# ── Leftenant ────────────────────────────────────────────────────────────────
# Leftenant runs a locally-built image. The setup scripts build LEFTENANT_IMAGE
# from LEFTENANT_GIT (a `docker build <giturl>` — see the README). Pin a different
# branch/tag/commit by changing the #ref, or point at your own fork.
LEFTENANT_IMAGE=intelligent-farming-stack/leftenant:local
LEFTENANT_GIT=https://github.com/intelligent-farming/leftenant.git#main
# Host port Leftenant is served on.
LEFTENANT_HOST_PORT=4173
# Browser origin Leftenant is reached at — MUST match LEFTENANT_HOST_PORT and the
# host. Used as the ChirpStack REST CORS allow-origin. For LAN access change all
# three of these to the device's address, e.g. http://192.168.1.50:4173 etc.
LEFTENANT_ORIGIN=http://localhost:4173
# URLs baked into Leftenant's runtime config.json (how the BROWSER reaches
# ChirpStack — not the compose network). Change the host for LAN access.
LEFTENANT_CHIRPSTACK_URL=http://localhost:8090
LEFTENANT_MQTT_URL=ws://localhost:9001
# Host a physical gateway forwards LoRaWAN packets to (ChirpStack Gateway Bridge,
# published at :1700 / :3001). A gateway can't reach `localhost`, so this must be
# the bench's LAN IP. Leave unset and setup.sh auto-detects the host LAN IP; the
# provisioner otherwise falls back to the LEFTENANT_CHIRPSTACK_URL host.
# LEFTENANT_GATEWAY_BRIDGE_HOST=192.168.1.50

# ── Mock sensors (demo data generator; opt-in) ───────────────────────────────
# The `mock-sensors` service simulates a handful of ag sensors and injects valid
# LoRaWAN uplinks via the gateway bridge, so mocked data flows through ChirpStack
# into the event store + MQTT stream. It only runs under the `mock` profile:
#   docker compose --profile mock up -d mock-sensors
# The harness is US915-only — it throws on any REGION but us915_0 / us915_1.
# Seconds between demo send rounds.
MOCK_INTERVAL_SECONDS=15
# Gateway EUI the mock registers and publishes under.
MOCK_GATEWAY_EUI=da7a9a7e00000001
# The four vars below only matter when the harness runs on the HOST (npm run
# provision/run in mock-sensors/, or scripts/e2e.sh) and talks to the stack over
# published ports. The compose service sets its own values for the compose network
# and ignores these. scripts/e2e.sh derives all four from the ports/credentials in
# this file, so leave them commented out unless you are pointing the harness at a
# stack somewhere else; an explicit value here wins.
#   MOCK_UDP_HOST / MOCK_UDP_PORT — Semtech UDP send target. Defaults to
#   localhost:${GATEWAY_BRIDGE_UDP_PORT}. Named MOCK_* because
#   GATEWAY_BRIDGE_UDP_PORT above is the host-side *mapping*, not the target.
#MOCK_UDP_HOST=localhost
#MOCK_UDP_PORT=1700
#   Broker + event store the e2e assertions read from.
#MOCK_MQTT_URL=mqtt://localhost:1883
#MOCK_EVENTS_PG_URL=postgres://events:changeme@localhost:5434/chirpstack_events

# ── Device-event store (ChirpStack PostgreSQL integration) ────────────────────
# Standalone Postgres that ChirpStack writes every device event into (it auto-
# creates the event_* tables). events-api serves read-only GraphQL/GraphiQL over it.
EVENTS_POSTGRES_USER=events         # DB owner; ChirpStack connects as this and creates the tables
EVENTS_POSTGRES_PASSWORD=changeme
EVENTS_POSTGRES_DB=chirpstack_events
EVENTS_POSTGRES_API_USER=events_api # read-only role PostGraphile connects as
EVENTS_POSTGRES_API_PASSWORD=changeme-api
EVENTS_POSTGRES_HOST_PORT=5434      # host-side psql / export
EVENTS_POSTGRES_HOST_BIND=127.0.0.1 # set 0.0.0.0 (or a LAN/VPN IP) to expose Postgres for Fivetran (TLS + firewall first!)
EVENTS_API_HOST_PORT=5050           # GraphQL endpoint (5000 is taken by macOS AirPlay Receiver)
EVENTS_API_HOST_BIND=127.0.0.1      # set 0.0.0.0 to expose on the LAN (TLS first!)
EVENTS_API_GRAPHIQL=true
# Schemas PostGraphile exposes. `leadsman` puts the rule engine's open alerts on the
# same GraphQL endpoint as the telemetry. Set to `public` if you remove Leadsman.
EVENTS_API_SCHEMAS=public,leadsman

# ── Leadsman (scheduled rule engine / alerting) ───────────────────────────────
# Reads the event_* tables on a cron and writes alerts to the `leadsman` schema in
# the same database. Runs by default. Which checks run is set in
# ./leadsman/leadsman.json (NOT here) — 14 fleet-health checks are on out of a menu
# of 64. Alerts are readable over the existing GraphQL at :5050.
#
# Published multi-arch image. `:0.3` tracks patch releases of the 0.3 line the way
# `chirpstack:4` tracks 4.x — it will not jump to 0.4 and change the config schema
# under you. Pin an exact version (:0.3.2) for a reproducible deployment, or
# :main to track the development branch.
#
# NOTE: a value set here is copied into your .env at install time and is NOT
# updated by `setup.sh --update` / `setup.ps1 -Update`, which leave .env alone.
# An image pin therefore survives every update — check this line when a version
# bump does not appear to take effect.
LEADSMAN_IMAGE=ghcr.io/intelligent-farming/leadsman:0.3
# Engine role: SELECT on public, INSERT/UPDATE on the leadsman schema. No DDL, no
# DELETE — it cannot alter ChirpStack's data. Created by events-initdb's
# 020_leadsman_role.sh. Generate a password: openssl rand -base64 24
# Clearing BOTH of these skips the role and is how you run the stack without Leadsman
# (also comment out the leadsman/leadsman-migrate services, or they will fail to connect).
POSTGRES_LEADSMAN_USER=leadsman
POSTGRES_LEADSMAN_PASSWORD=changeme-leadsman
# Index the event_* tables (time, dev_eui+time) as part of `leadsman migrate`. Every
# check filters by time and groups by dev_eui; unindexed, each sounding is a
# sequential scan. On by default — this stack owns events-postgres outright, and the
# tables are empty on a fresh volume so the CREATE INDEXes are instant. Set false to
# leave ChirpStack's tables exactly as it created them.
LEADSMAN_APPLY_EVENT_INDEXES=true

# Gateway visibility. Path to the provisioner's shared config, which already holds
# chirpStackUrl + apiKey + tenantId + gatewayBridgeHost. The default is correct for this
# stack and needs no change — the `shared` volume is mounted read-only into leadsman.
#
# It enables three checks that cannot work from the event store alone: a gateway that is
# CONNECTED but hearing nothing (dead concentrator, antenna off its mount), one registered
# and never heard from, and a change in the host's LAN address. That last one is the fix
# for the failure where a power cut brings the host back on a new DHCP lease: gateways
# never rediscover their network server, so every one of them keeps forwarding to an
# address nobody is listening on, while reporting itself perfectly healthy.
#
# Clear it to run without those checks; they report `skipped`, not a false all-clear.
LEADSMAN_CHIRPSTACK_CONFIG=/shared/config.json

# Liveness ping, POSTed after every sounding. THE ONLY signal that survives this edge
# device being off.
#
# Every check works by finding something wrong in the data, which requires the engine to
# be running — so a power cut, a panic, or a container that never came back produces no
# alerts at all, and from outside is indistinguishable from a quiet night. Inverting the
# signal is the only fix, and the receiver has to be somewhere the outage cannot reach: a
# watchdog on this same box dies with it. A hosted ping service (healthchecks.io and
# similar) or a Hermes route on other hardware both work.
#
#   docker compose run --rm leadsman test-notify --to heartbeat
#
# host-restarted reports the same outage retrospectively, once the box is back. Blank
# here means no heartbeat, and no way to learn about an outage while it is happening.
LEADSMAN_HEARTBEAT_URL=
# Secret for that endpoint, if it authenticates. Falls back to LEADSMAN_WEBHOOK_TOKEN.
LEADSMAN_WEBHOOK_TOKEN_HEARTBEAT=

# Where alerts get delivered. Which destinations exist, and which alerts go to each, is
# set in ./leadsman/leadsman.json under notify.destinations + notify.routing. Nothing is
# delivered until you add that block — alerts are still recorded and readable over GraphQL.
#
# Only the secrets and per-host overrides live here. NAME below is a destination name from
# that file, upper-cased with hyphens as underscores (destination "on-call" -> ON_CALL):
#   LEADSMAN_DEST_<NAME>_WEBHOOK_URL   point a webhook destination somewhere
#   LEADSMAN_DEST_<NAME>_PROVIDER      webhook | twilio | telegram | signal
#   LEADSMAN_DEST_<NAME>_TO            recipients, comma-separated E.164
#   LEADSMAN_DEST_<NAME>_CHAT_ID       Telegram chat id
#   LEADSMAN_WEBHOOK_TOKEN_<NAME>      that destination's shared secret
# e.g. to send a destination named `agent` at a Hermes route on the Docker host:
#   LEADSMAN_DEST_AGENT_WEBHOOK_URL=http://host.docker.internal:8644/hermes/agent
#
# Shared-secret fallback, used by any webhook destination without its own token. `hmac` (set
# per destination in the config) signs <unix-seconds>.<body> and is replay-safe; it is what
# Hermes' generic webhook route verifies. `token` and `bearer` have no replay protection.
# (Keep this on its own line with no trailing comment — an empty value followed by an inline
# # comment is parsed as the value by docker compose.)
LEADSMAN_WEBHOOK_TOKEN=

# ── Outbound messaging credentials ────────────────────────────────────────────
# Leadsman can send alerts directly, without a webhook receiver in between. Which
# alerts go where is set in ./leadsman/leadsman.json under notify.destinations; the
# credentials live here so that file stays committable.
#
# Pick whichever platform you use — set only that one's variables. A destination whose
# provider has no credentials is rejected when the config is parsed, so a typo here
# fails at startup rather than on the first alert at 3am.
#
# Twilio SMS. All four are required together, and it authenticates with an API KEY rather
# than the Account Auth Token — a key can be revoked and rotated on its own, where the Auth
# Token is the account's master credential. Create one under Twilio Console > Account >
# API keys & tokens > Standard key; the Account SID is still needed because it names the
# account the key acts on. FROM is a Twilio number or a messaging-service sender.
# Trial accounts can only text verified numbers.
LEADSMAN_TWILIO_ACCOUNT_SID=
LEADSMAN_TWILIO_API_KEY_SID=
LEADSMAN_TWILIO_API_KEY_SECRET=
LEADSMAN_TWILIO_FROM=
# Telegram. Create a bot with @BotFather (it gives you the token). Then find the chat id,
# which is the step people get stuck on:
#   1. add the bot to the group, or send it a direct message
#   2. send one message in that chat
#   3. curl "https://api.telegram.org/bot<TOKEN>/getUpdates" and read result[].message.chat.id
# Groups and channels are NEGATIVE (-1001234567890); a direct chat is positive. A bot cannot
# start a conversation, so step 2 is required — without it getUpdates is empty.
# Put the chat id in the destination's "chatId" in leadsman.json, or LEADSMAN_DEST_<NAME>_CHAT_ID.
LEADSMAN_TELEGRAM_BOT_TOKEN=
# Signal. There is no hosted send API, so this stack ships an opt-in signal-cli service:
#   docker compose --profile signal up -d signal-cli
# then register the number once (captcha + SMS code — see the comments on that service in
# docker-compose.yml; it cannot be automated). Once registered:
#   LEADSMAN_SIGNAL_BASE_URL=http://signal-cli:8080
#   LEADSMAN_SIGNAL_FROM=+15125550000
# To message a group, put its id in the destination's "to" array — signal-cli reports them as
# group.<base64>, listed by:  docker compose exec signal-cli signal-cli -a +1512... listGroups
LEADSMAN_SIGNAL_BASE_URL=
LEADSMAN_SIGNAL_FROM=
# Per-destination overrides, to change platform or recipients without editing the
# config file. NAME is the destination name upper-cased, hyphens to underscores:
#   LEADSMAN_DEST_ONCALL_PROVIDER=telegram
#   LEADSMAN_DEST_ONCALL_TO=+15125550123,+15125550124
#   LEADSMAN_DEST_ONCALL_CHAT_ID=-1001234567890
# Engine logging. `json` suits a log shipper; `text` is easier to read by eye.
LEADSMAN_LOG_LEVEL=info
LEADSMAN_LOG_FORMAT=json
# Resource ceiling, so soundings cannot crowd out ChirpStack's ingestion on a small
# device. Raise if you enable many checks over a large fleet.
LEADSMAN_CPUS=0.50
LEADSMAN_MEMORY=256M

# ── Fivetran / log-based CDC on events-postgres (opt-in) ──────────────────────
# See README "Fivetran / off-device sync". All disabled by default.
# 1) wal_level=logical enables the write-ahead log Fivetran's log-based
#    connector reads. Leave `replica` unless you're syncing off-device.
EVENTS_POSTGRES_WAL_LEVEL=replica   # set `logical` for Fivetran log-based CDC, then recreate events-postgres
EVENTS_POSTGRES_MAX_WAL_SENDERS=10  # PG16 default; one Fivetran slot fits
EVENTS_POSTGRES_MAX_REPLICATION_SLOTS=10
# 2) Dedicated read-only replication role. Set BOTH to have events-initdb's
#    010_events_roles.sh create the role + publication. Leaving either blank
#    skips it. Example user: fivetran. Generate a password: openssl rand -base64 24
#    (Keep these two on their own lines with no trailing comment — an empty value
#    followed by an inline # comment is parsed as the value by docker compose.)
EVENTS_POSTGRES_FIVETRAN_USER=
EVENTS_POSTGRES_FIVETRAN_PASSWORD=
EVENTS_POSTGRES_FIVETRAN_PUBLICATION=fivetran_pub

# ── Farm telemetry store (opt-in via the `farm` profile) ──────────────────────
# The normalized telemetry path: ChirpStack's MQTT events become per-metric
# readings in `farmdata`, served read-only over GraphQL. Nothing here starts
# unless the profile is named: docker compose --profile farm up -d
# See README "Farm telemetry store & GraphQL".
#
# THE IMAGES ARE NOT PUBLISHED YET. Build them once in a telemetry-bridge
# checkout (`npm run images:build`); this stack consumes the tags from the local
# Docker image store. Without that, `up` fails with "pull access denied".
FARM_POSTGRES_IMAGE=intelligent-farming/farm-postgres:dev
FARMDATA_MIGRATE_IMAGE=intelligent-farming/farmdata-migrate:dev
TELEMETRY_BRIDGE_IMAGE=intelligent-farming/telemetry-bridge:dev

# The database itself. The owning superuser: CREATE EXTENSION pg_partman needs
# one, so the services below connect as least-privilege logins instead.
FARM_POSTGRES_USER=farmdata_owner
FARM_POSTGRES_PASSWORD=changeme
FARM_POSTGRES_DB=farmdata           # lowercase/digits/underscore only: migrations splice it into SQL unquoted
FARM_POSTGRES_HOST_PORT=5436        # 5434 is the event store, 5435 the telemetry-bridge repo's own harness
FARM_POSTGRES_HOST_BIND=127.0.0.1   # set 0.0.0.0 (or a LAN/VPN IP) to expose it (TLS + firewall first!)

# Login users, minted by farmdata-migrate. The migration chain creates only
# NOLOGIN group roles -- privilege carriers, not accounts, so that a frozen
# committed migration never holds a password -- and each login below is granted
# membership in exactly one of them. Bench placeholders; rotate for anything real.
FARM_BRIDGE_LOGIN_USER=farmdata_bridge      # granted bridge_writer: ingest and curation
FARM_BRIDGE_LOGIN_PASSWORD=changeme-bridge
FARM_API_LOGIN_USER=farmdata_api            # granted farm_read: the GraphQL layer
FARM_API_LOGIN_PASSWORD=changeme-farm-api
# The third pair is the one whose role owns tables. partman_maintainer owns
# telemetry.reading and telemetry.ingest_event: creating and dropping their
# partitions requires owning the parent, and ownership is the one privilege no
# GRANT can confer -- so maintenance cannot borrow the bridge's own login the way
# everything else borrows bridge_writer. Blank leaves partition maintenance
# unscheduled, which the daemon announces at startup and repeats in every ingest
# report.
FARM_BRIDGE_MAINT_LOGIN_USER=farmdata_maint # granted partman_maintainer: partition maintenance
FARM_BRIDGE_MAINT_LOGIN_PASSWORD=changeme-maint

# The bridge. One client id per broker: the MQTT session is persistent, so a
# second daemon using this id would take the session over and the two would
# disconnect each other in a loop. Never scale the telemetry-bridge service.
FARM_BRIDGE_CLIENT_ID=telemetry-bridge
FARM_BRIDGE_SIGNAL_HEALTH=on                # best-gateway rssi/snr readings per uplink
FARM_BRIDGE_RECONCILE_INTERVAL_SECONDS=600  # ChirpStack inventory sweep; 60-86400
FARM_BRIDGE_CHIRPSTACK_TIMEOUT_SECONDS=10   # per-request deadline, covering a whole listing; 1-300
# Where an unplaced device lands first. Left blank the entrypoint derives it
# from farm/projection.json, which is the same file farmdata-migrate seeds --
# so the two cannot disagree. Set it only to point at a different property.
# (Keep this on its own line with no trailing comment — an empty value followed
# by an inline # comment is parsed as the value by docker compose.)
FARM_BRIDGE_PROPERTY_ID=

# The curation API: how a person says where a device actually is.
# THIS RELEASE SERVES NO AUTHENTICATION AND NO TLS. Its security is the network
# it listens on. Move the bind off loopback only behind both.
FARM_CURATION_HOST_PORT=8092        # 8091 is the telemetry-bridge repo's own harness
FARM_CURATION_HOST_BIND=127.0.0.1
FARM_BRIDGE_CURATION_LAG_DAYS=7     # how long an auto-created device may go unplaced before the alarm names it; 1-365
FARM_BRIDGE_CURATION_CHECK_INTERVAL_SECONDS=3600

# How often the bridge logs its ingest counters. The counters are the only
# outside evidence that a message was dropped deliberately rather than lost --
# an unparseable payload, a clock too far ahead to be a delivery time -- and
# that a redelivery was deduped rather than never sent. `docker compose kill
# -s USR2 telemetry-bridge` asks for one now; it also reports on shutdown.
FARM_BRIDGE_REPORT_INTERVAL_SECONDS=300   # 10-86400

# How often the bridge repeats partition maintenance after the pass it runs at
# startup. The startup pass is the load-bearing one: it is what guarantees a
# partition exists for whatever arrives, on a box that may have been powered off
# for longer than the three months premake keeps ahead. Run it on demand with
# `docker compose run --rm --no-deps telemetry-bridge maintain` (0 healthy, 2
# degraded, 1 could not run).
FARM_BRIDGE_MAINTAIN_INTERVAL_SECONDS=86400   # 60-86400

# Read-only GraphQL over farmdata.
FARM_API_HOST_PORT=5051             # 5050 is the event store's GraphQL endpoint
FARM_API_HOST_BIND=127.0.0.1        # set 0.0.0.0 to expose on the LAN (TLS first!)
FARM_API_GRAPHIQL=true

# Server settings. pg_partman's background worker is preloaded from first boot
# because changing shared_preload_libraries costs a restart, but it stays idle
# and is not how maintenance runs here -- the bridge daemon schedules it, and
# `telemetry-bridge maintain` runs it on demand with a health verdict as its exit
# code. Turning the worker on instead needs pg_partman_bgw.role flipped to a
# LOGIN role with credentials and a server restart to change its database, and it
# reports failure nowhere but the server log, at WARNING. Pointed at a database
# the chain has not yet migrated it fails every cycle. Unsupported.
FARM_POSTGRES_WAL_LEVEL=replica
FARM_POSTGRES_MAX_WAL_SENDERS=10
FARM_POSTGRES_MAX_REPLICATION_SLOTS=10
FARM_POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=2GB
FARM_POSTGRES_SHARED_PRELOAD=pg_partman_bgw
FARM_POSTGRES_PARTMAN_BGW_DBNAME=
